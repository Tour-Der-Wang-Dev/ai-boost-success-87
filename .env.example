# AI Boost Success CRM - Environment Configuration Template
# Copy this file to .env.local and fill in your actual values

# =============================================================================
# SUPABASE CONFIGURATION
# =============================================================================
# Your Supabase project URL - find this in your Supabase dashboard
# Format: https://[project-ref].supabase.co
VITE_SUPABASE_URL=https://inaiwowobcjubchogjda.supabase.co

# Supabase anonymous/public key - safe to expose in frontend
# This key has limited permissions defined by Row Level Security (RLS) policies
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImluYWl3b3dvYmNqdWJjaG9namRhIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NTQzMzUyNzAsImV4cCI6MjA2OTkxMTI3MH0.XdQvDLzdID_XWLp4rbXSa9RhRm_U1ZvwHpzPp-MZwNU

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
# Application title displayed in browser tab and meta tags
VITE_APP_TITLE="AI Boost Success CRM"

# Application description for SEO and meta tags
VITE_APP_DESCRIPTION="Modern Customer Relationship Management System with AI-powered insights"

# Application version (automatically updated during build)
VITE_APP_VERSION="1.0.0"

# =============================================================================
# DEVELOPMENT SETTINGS (Development Only)
# =============================================================================
# Enable development mode features (debug panels, verbose logging)
# Set to "false" or remove for production
VITE_DEV_MODE=true

# Logging level: "debug", "info", "warn", "error"
# Use "error" for production, "debug" for development
VITE_LOG_LEVEL=debug

# Enable React Developer Tools in production build
# NEVER set to true in production unless debugging
VITE_REACT_DEV_TOOLS=false

# =============================================================================
# API CONFIGURATION
# =============================================================================
# API base URL (if using external APIs)
# VITE_API_BASE_URL=https://api.example.com

# API timeout in milliseconds
# VITE_API_TIMEOUT=10000

# =============================================================================
# AUTHENTICATION SETTINGS
# =============================================================================
# JWT secret for token validation (Backend only - not exposed to frontend)
# JWT_SECRET=your-super-secret-jwt-key-here

# Session timeout in seconds (default: 24 hours)
# VITE_SESSION_TIMEOUT=86400

# Enable social login providers
# VITE_ENABLE_GOOGLE_AUTH=true
# VITE_ENABLE_GITHUB_AUTH=true

# =============================================================================
# AI/OPENAI CONFIGURATION (If applicable)
# =============================================================================
# OpenAI API key for AI features (Backend only - NEVER expose to frontend)
# OPENAI_API_KEY=sk-your-openai-api-key-here

# AI model configuration
# VITE_AI_MODEL=gpt-3.5-turbo
# VITE_AI_MAX_TOKENS=1000

# =============================================================================
# ANALYTICS & MONITORING
# =============================================================================
# Google Analytics tracking ID
# VITE_GA_TRACKING_ID=G-XXXXXXXXXX

# Sentry DSN for error tracking
# VITE_SENTRY_DSN=https://your-sentry-dsn-here

# Enable performance monitoring
# VITE_ENABLE_PERFORMANCE_MONITORING=false

# =============================================================================
# FEATURE FLAGS
# =============================================================================
# Enable/disable specific features
# VITE_FEATURE_AI_INSIGHTS=true
# VITE_FEATURE_SOCIAL_SHARING=true
# VITE_FEATURE_BILLING=true
# VITE_FEATURE_DARK_MODE=true

# =============================================================================
# SOCIAL MEDIA INTEGRATION
# =============================================================================
# Social media API keys (Backend only)
# TWITTER_API_KEY=your-twitter-api-key
# LINKEDIN_API_KEY=your-linkedin-api-key

# =============================================================================
# EMAIL CONFIGURATION (Backend only)
# =============================================================================
# SMTP configuration for email sending
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASSWORD=your-app-password
# EMAIL_FROM=noreply@yourdomain.com

# =============================================================================
# STORAGE CONFIGURATION
# =============================================================================
# File upload limits
# VITE_MAX_FILE_SIZE=10485760  # 10MB in bytes
# VITE_ALLOWED_FILE_TYPES=.jpg,.jpeg,.png,.pdf,.doc,.docx

# =============================================================================
# SECURITY SETTINGS
# =============================================================================
# Enable HTTPS redirect (production only)
# VITE_FORCE_HTTPS=true

# Content Security Policy (production)
# VITE_CSP_ENABLED=false

# =============================================================================
# DEPLOYMENT SETTINGS
# =============================================================================
# Deployment environment: "development", "staging", "production"
NODE_ENV=development

# Build output directory
# BUILD_DIR=dist

# Enable source maps in production (not recommended for security)
# VITE_SOURCEMAP=false

# =============================================================================
# LOCALIZATION (Future feature)
# =============================================================================
# Default language
# VITE_DEFAULT_LOCALE=en

# Available languages
# VITE_AVAILABLE_LOCALES=en,th,ja

# =============================================================================
# NOTES FOR DEVELOPERS
# =============================================================================
# 
# 1. SECURITY CONSIDERATIONS:
#    - Never commit this file with real values to version control
#    - Use .env.local for local development (this file is git-ignored)
#    - Backend environment variables (without VITE_ prefix) are not exposed to the frontend
#    - Frontend environment variables (with VITE_ prefix) are bundled into the client-side code
#
# 2. VARIABLE NAMING CONVENTIONS:
#    - Frontend variables: VITE_[SECTION]_[NAME]
#    - Backend variables: [SECTION]_[NAME]
#    - Use UPPERCASE_WITH_UNDERSCORES
#
# 3. DEPLOYMENT:
#    - Set production values in your hosting platform's environment variable settings
#    - Different values can be set for different environments (dev, staging, prod)
#    - Some platforms auto-detect common variables like DATABASE_URL
#
# 4. VITE ENVIRONMENT VARIABLES:
#    - Only variables prefixed with VITE_ are exposed to the frontend
#    - They are replaced at build time, not runtime
#    - Boolean values should be strings: "true" or "false"
#    - Undefined variables will be replaced with undefined
#
# 5. VALIDATION:
#    - Add validation in your app startup to ensure required variables are set
#    - Use a schema validation library like Zod for type safety
#
# =============================================================================

# Example local development file (.env.local):
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key
# VITE_DEV_MODE=true
# VITE_LOG_LEVEL=debug